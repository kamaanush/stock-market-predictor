            experimental_edge_summary
            is not present yet.
          </div>
        )}
      </div>
        {selectedOpportunity && (
          <OpportunityDetail
            item={selectedOpportunity}
            onClose={() =>
              setSelectedOpportunity(
                null,
              )
            }
          />
        )}

    </main>
  );
}
