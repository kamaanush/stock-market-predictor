"use client";

import LiveEdgeHoverSidebar from "../../components/live-edge/LiveEdgeHoverSidebar";

import {
  useCallback,
  useEffect,
  useState,
} from "react";

import OpportunityDetail from "../../components/live-edge/OpportunityDetail";


const API_BASE =
  "http://localhost:8000";


type Opportunity = {
  symbol: string;
  ltp: number;
  opportunity_score: number;
  opportunity_state: string;
  status: string;
};


type PaperCandidate = {
  symbol: string;
  ltp: number;
  direction: string;

  opportunity_score: number;
  opportunity_state: string;

  reclaim_quality: number;
  reclaim_state: string;

  context_setup: string;
  context_direction: string;

  structural_stop?: number | null;
  structural_risk_percent?: number | null;
};


type EdgeSummary = {
  mode: string;

  ready_stocks: number;

  opportunity_40_plus: number;
  opportunity_50_plus: number;
  opportunity_60_plus: number;

  opposed_reclaim_candidates: number;

  pending_paper_outcomes: number;

  top_opportunities: Opportunity[];

  paper_candidates: PaperCandidate[];
};


type FastScanResponse = {
  generated_at?: string;

  scored_count?: number;

  experimental_edge_summary?: EdgeSummary;
};


function scoreClass(
  score: number,
) {

  if (score >= 60) {
    return (
      "bg-red-500/15 " +
      "text-red-300 " +
      "border-red-500/30"
    );
  }

  if (score >= 50) {
    return (
      "bg-orange-500/15 " +
      "text-orange-300 " +
      "border-orange-500/30"
    );
  }

  if (score >= 40) {
    return (
      "bg-yellow-500/15 " +
      "text-yellow-300 " +
      "border-yellow-500/30"
    );
  }

  return (
    "bg-slate-500/10 " +
    "text-slate-300 " +
    "border-slate-500/20"
  );
}


function directionClass(
  direction: string,
) {

  if (direction === "BULLISH") {
    return (
      "bg-emerald-500/15 " +
      "text-emerald-300 " +
      "border-emerald-500/30"
    );
  }

  if (direction === "BEARISH") {
    return (
      "bg-red-500/15 " +
      "text-red-300 " +
      "border-red-500/30"
    );
  }

  return (
    "bg-slate-500/10 " +
    "text-slate-300 " +
    "border-slate-500/20"
  );
}


function MetricCard({
  label,
  value,
  description,
}: {
  label: string;
  value: string | number;
  description?: string;
}) {

  return (
    <div
      className="
        rounded-2xl
        border
        border-slate-800
        bg-slate-900/70
        p-5
      "
    >
      <div
        className="
          text-sm
          text-slate-400
        "
      >
        {label}
      </div>

      <div
        className="
          mt-2
          text-3xl
          font-bold
          text-white
        "
      >
        {value}
      </div>

      {description && (
        <div
          className="
            mt-2
            text-xs
            text-slate-500
          "
        >
          {description}
        </div>
      )}
    </div>
  );
}


export default function LiveEdgePage() {

  const [
    data,
    setData,
  ] = useState<FastScanResponse | null>(
    null,
  );

  const [
    loading,
    setLoading,
  ] = useState(true);

  const [
    error,
    setError,
  ] = useState("");

  const [
    autoRefresh,
    setAutoRefresh,
  ] = useState(true);

