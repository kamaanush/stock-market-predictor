# Copy to .env and fill locally. Do not commit .env.
APP_PASSWORD=choose-a-long-private-password
SESSION_SECRET=replace-with-a-random-32-plus-character-secret
DATABASE_URL=postgresql+asyncpg://stocktracker:stocktracker@postgres:5432/stocktracker

# Angel One SmartAPI read-only data connection
SMARTAPI_API_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PIN=
SMARTAPI_TOTP_SECRET=

# Optional Telegram alerts. A chat ID alone is insufficient; create a bot and add its token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

